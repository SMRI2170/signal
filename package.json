{
  "name": "signal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality:dead-code": "npx --yes knip@6.39.0",
    "quality:cycles": "npx --yes dependency-cruiser@18.5.0 src --include-only '^src' --config .dependency-cruiser.cjs",
    "quality:bundle": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@typesafe-ai/sdk": "^0.6.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "knip": {
    "entry": [
      "src/**/*.{ts,tsx}",
      "public/sw.js",
      "supabase/functions/*/index.ts"
    ],
    "ignoreDependencies": [
      "prettier"
    ]
  }
}
